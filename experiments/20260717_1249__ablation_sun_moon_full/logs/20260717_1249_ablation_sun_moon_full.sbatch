#!/bin/bash
#SBATCH --job-name=20260717_1249_ablation_sun_moon_full
#SBATCH --partition=3090-gcondo
#SBATCH --nodes=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=125G
#SBATCH --time=12:00:00
#SBATCH --gres=gpu:1
#SBATCH --signal=SIGUSR1@90
#SBATCH --chdir=/users/cjmok/automated-perspective-sculptor
#SBATCH --output=./logs/%x.%j.out
